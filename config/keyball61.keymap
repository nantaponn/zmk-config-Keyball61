#define DEFAULT 0
#define SYM     1
#define FUN     2
#define MOUSE   3
#define SCROLL  4
#define SNIPE   5

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// 1. ตั้งค่าความเร็วการเคลื่อนที่และระยะ Scroll ใหม่อย่างถูกต้อง

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 5

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Mouse {
            bindings = <&tog 4>;
            key-positions = <32 33>;
        };

        TH-EN {
            bindings = <&kp GRAVE>;
            key-positions = <28 31>;
        };

        Printsc {
            bindings = <&kp PSCRN>;
            key-positions = <27 28>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <31 32>;
        };

        Cut {
            bindings = <&kp LC(X)>;
            key-positions = <45 46>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <33 34>;
        };

        Snipe {
            bindings = <&mo 6>;
            key-positions = <46 47>;
        };

        Number {
            bindings = <&tog 1>;
            key-positions = <40 39>;
        };

        Cal {
            bindings = <&kp K_CALCULATOR>;
            key-positions = <15 14>;
            layers = <1>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESC         &kp N1  &kp N2        &kp N3        &kp N4  &kp N5                                   &kp N6           &kp N7  &kp N8     &kp N9   &kp N0         &kp BSPC
&kp TAB         &kp Q   &kp W         &kp E         &kp R   &kp T                                    &kp Y            &kp U   &kp I      &kp O    &kp P          &kp BACKSLASH
&kp CAPS        &kp A   &kp S         &kp D         &kp F   &kp G                                    &kp H            &kp J   &kp K      &kp L    &kp SEMI       &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X         &kp C         &kp V   &kp B        &kp PAGE_DOWN  &kp PAGE_UP  &kp N            &kp M   &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
&kp LCTRL       &none   &kp LEFT_ALT  &kp LEFT_WIN  &mo 6   &lt 5 SPACE  &kp K_MUTE     &kp ENTER    &lt 2 BACKSPACE                              &kp RIGHT_ALT  &kp DELETE
            >;
        };

        number_layer {
            bindings = <
&trans  &trans         &trans           &trans     &trans    &trans                     &trans    &trans  &trans  &trans  &trans     &trans
&trans  &trans         &trans           &trans     &trans    &trans                     &trans    &kp N7  &kp N8  &kp N9  &kp EQUAL  &trans
&trans  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS  &kp PLUS  &trans                     &kp DOT   &kp N4  &kp N5  &kp N6  &kp N0     &trans
&trans  &trans         &trans           &trans     &trans    &trans  &trans  &trans     &trans    &kp N1  &kp N2  &kp N3  &trans     &trans
&trans  &trans         &trans           &trans     &trans    &trans  &trans  &kp ENTER  &kp BSPC                          &trans     &trans
            >;

            label = "NUM";
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans           &trans        &trans        &trans        &trans                       &trans          &trans         &trans            &trans                &trans                 &trans
&trans  &bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &trans                 &trans
&trans  &trans           &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans       &trans  &trans  &kp UNDERSCORE  &kp PLUS       &trans            &trans                &trans                 &trans
&trans  &trans           &trans        &trans        &trans        &trans       &trans  &trans  &trans                                                                 &trans                 &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans     &trans  &trans  &trans  &trans  &trans                     &kp C_BRI_DEC    &trans      &kp UP_ARROW       &trans        &trans     &kp C_BRIGHTNESS_INC
&trans     &trans  &trans  &trans  &trans  &trans                     &trans           &kp LEFT    &kp DOWN_ARROW     &kp RIGHT     &trans     &trans
&trans     &trans  &trans  &trans  &trans  &trans                     &kp PAGE_UP      &mkp LCLK   &mo 5              &mkp RCLK     &mkp MCLK  &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &kp PAGE_DOWN    &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOL_UP  &trans     &trans
&kp LCTRL  &trans  &trans  &trans  &trans  &trans  &trans  &kp ENTER  &lt 2 BACKSPACE                                               &trans     &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &kp MINUS         &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &kp LEFT_BRACKET  &kp RBKT
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans            &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans            &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans         &trans          &kp UP_ARROW       &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &mkp MB4       &kp LEFT_ARROW  &kp DOWN_ARROW     &kp RIGHT     &mkp MB5   &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &kp PAGE_UP    &mkp LCLK       &kp N5             &mkp RCLK     &mkp MCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &kp PAGE_DOWN  &kp C_MUTE      &kp C_VOLUME_DOWN  &kp C_VOL_UP  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp ENTER  &kp BACKSPACE                                                   &trans     &trans
            >;
        };
    };
};
